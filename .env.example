# Clickpoint - environment template. Copy to .env.local and fill in.

# Hack Club AI key from https://ai.hackclub.com (sign in with Hack Club).
# The LOGFARE_* names are historical: their values are a Hack Club key, the
# Hack Club base URL, and OpenRouter model slugs.
LOGFARE_API_KEY=
# Hack Club's OpenAI-compatible endpoint (proxies all of OpenRouter).
LOGFARE_BASE_URL=https://ai.hackclub.com/proxy/v1
LOGFARE_MODEL=deepseek/deepseek-v4.1-flash-1017
# OpenRouter model slugs, tried left to right after the primary. Empty disables backups.
LOGFARE_FALLBACK_MODELS=
# The default model reasons optionally; this caps how much it thinks. low | high | max | none.
# Cards come out faster and tighter on "low". Leave empty to use the model default (high).
LOGFARE_REASONING_EFFORT=low
# true = ask hybrid reasoning models to skip hidden thinking. Safe to leave on.
LOGFARE_DISABLE_THINKING=true

# Optional: the correctness reviewer. It receives the exact document the
# learner sees (macro CSS + the card's own CSS, markup and JS) and returns
# surgical patches for anything FACTUALLY wrong — never style. A different
# model from the writer is strongly recommended: the model that wrote a
# number is the worst judge of it. Leave empty to reuse LOGFARE_MODEL.
LOGFARE_REVIEW_MODEL=

# Path to the Chromium executable used to verify generated cards (they must
# execute, drag, and paint before a learner ever sees them). The Docker image
# sets this automatically; on local dev, point it at your Chrome/Chromium.
# Leave empty to fall back through the common install locations.
CHROMIUM_PATH=

# Postgres connection string (Supabase). Guest + pathway records live here, so
# the app needs no persistent disk and can run on a host without volumes.
# Use the *pooler* connection string (port 6543), NOT the direct one (5432):
# each serverless invocation opens a connection and the direct port runs out.
# Run db/schema.sql once to create the tables.
DATABASE_URL=
